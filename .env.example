# ─── n8n Webhook integration ──────────────────────────────────────────────────
# HMAC secret shared with n8n for request signature verification
N8N_HMAC_SECRET=change_me

# Full URL of the n8n webhook that receives contact form submissions
N8N_WEBHOOK_URL=https://your-n8n-instance.example.com/webhook/contact
# ─── Cloudflare Tunnel ────────────────────────────────────────────────────────
# Read by docker-compose.yml. Compose only interpolates ${...} from a file named
# `.env` in this directory, so this variable must live in `.env`, not `.env.local`.
CLOUDFLARE_TUNNEL_TOKEN=
